# Local execution only. Production values live in the Modal secret
# `pipeline-engine-hiring-outreach-secrets`.
LEMLIST_API_KEY=
APOLLO_API_KEY=
# Optional fallback provider:
INSTANTLY_API_KEY=

# Use either inline service-account JSON or a local credential file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Used by the protected Modal HTTP endpoint called by n8n.
PIPELINE_ENGINE_HIRING_TRIGGER_TOKEN=

# Optional local override for the Python environment containing
# mcp-server-linkedin.
LINKEDIN_PYTHON=
