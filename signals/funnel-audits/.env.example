# Local execution only. Production values are split across these Modal secrets:
# funnel-audit-openai, funnel-audit-google, funnel-audit-config,
# funnel-audit-composio, and pipeline-gap-downstream-secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=funnel-audit-system
GOOGLE_OAUTH_JSON=

# Audit identity and safety settings.
AUDIT_NAME=
AUDIT_EMAIL=
AUDIT_PHONE=
AUDIT_TITLE=
AUDIT_COMPANY=
LIVE_SUBMISSIONS=false
BROWSER_TASK_TIMEOUT_SECONDS=300

# Downstream contact discovery and Lemlist routing.
LEMLIST_API_KEY=
APOLLO_API_KEY=
INSTANTLY_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
SLACK_WEBHOOK_URL=
